# Copy to .env and fill in your own keys. Never commit .env.

# sync. API key from Settings > API keys in the sync dashboard (https://sync.so/docs/quickstart)
SYNC_API_KEY=

# Any OpenAI-compatible LLM for the translation (leave empty to pass the script through untranslated)
OPENAI_API_KEY=
# Optional: use Groq or Gemini instead of OpenAI
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL=gpt-4.1-mini

# Optional: ElevenLabs voice id (python cli.py --check lists the ones your key can use)
# SYNC_VOICE_ID=EXAVITQu4vr4xnSDxMaL
